<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcBtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@animator/button_scale</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="CalcBtnNum" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_num</item>
        <item name="android:textColor">@color/btn_num_text</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="CalcBtnSci" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_sci</item>
        <item name="android:textColor">@color/btn_sci_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcBtnFunc" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_sci</item>
        <item name="android:textColor">@color/btn_sci_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CalcBtnOp" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_op</item>
        <item name="android:textColor">@color/btn_op_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="CalcBtnEquals" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_equals</item>
        <item name="android:textColor">@color/btn_equals_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="CalcBtnClear" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_sci</item>
        <item name="android:textColor">@color/btn_clear_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
