<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_cyan">#8c7ae6</color>
    <color name="accent_violet">#8c7ae6</color>
    <color name="bg_dark">#F0F2F5</color>
    <color name="black">#FF000000</color>
    <color name="btn_clear_text">#8c7ae6</color>
    <color name="btn_equals_bg">#8c7ae6</color>
    <color name="btn_equals_text">#FFFFFF</color>
    <color name="btn_num_bg">#FFFFFF</color>
    <color name="btn_num_text">#1E1E1E</color>
    <color name="btn_op_bg">#EAE5F7</color>
    <color name="btn_op_text">#8c7ae6</color>
    <color name="btn_sci_bg">#F4F2FC</color>
    <color name="btn_sci_text">#8c7ae6</color>
    <color name="calc_bg">#F0F2F5</color>
    <color name="calc_display_bg">#FFFFFF</color>
    <color name="card_bg">#FFFFFF</color>
    <color name="ic_launcher_background">#FFFFFF</color>
    <color name="ripple_dark">#40000000</color>
    <color name="ripple_light">#40000000</color>
    <color name="text_primary">#1E1E1E</color>
    <color name="text_secondary">#757575</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">Calculator</string>
    <style name="CalcBtnBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@animator/button_scale</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="CalcBtnClear" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_sci</item>
        <item name="android:textColor">@color/btn_clear_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="CalcBtnEquals" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_equals</item>
        <item name="android:textColor">@color/btn_equals_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="CalcBtnFunc" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_sci</item>
        <item name="android:textColor">@color/btn_sci_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CalcBtnNum" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_num</item>
        <item name="android:textColor">@color/btn_num_text</item>
        <item name="android:textSize">22sp</item>
    </style>
    <style name="CalcBtnOp" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_op</item>
        <item name="android:textColor">@color/btn_op_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>
    <style name="CalcBtnSci" parent="CalcBtnBase">
        <item name="android:background">@drawable/bg_button_sci</item>
        <item name="android:textColor">@color/btn_sci_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Theme.NovaCalc" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/calc_display_bg</item>
        <item name="colorPrimaryVariant">@color/calc_bg</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/calc_bg</item>
    </style>
</resources>