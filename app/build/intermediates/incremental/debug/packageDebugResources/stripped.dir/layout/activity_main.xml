<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/calc_bg"
    android:padding="8dp"
    android:animateLayoutChanges="true">

    <!-- Top Bar with Hamburger Menu & History -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        
        <ImageButton
            android:id="@+id/btnNavMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@color/text_primary"
            android:contentDescription="Navigation Menu"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_recent_history"
            android:tint="@color/text_primary"
            android:contentDescription="Calculation History"/>

    </LinearLayout>

    <!-- Normal Display Area -->
    <LinearLayout
        android:id="@+id/layoutNormalDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:orientation="vertical"
        android:gravity="bottom|end"
        android:background="@drawable/bg_button_num"
        android:layout_marginBottom="12dp"
        android:padding="16dp"
        android:elevation="4dp">

        <ScrollView
            android:id="@+id/svHistoryTape"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/layoutHistoryTape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="bottom|start"
                android:animateLayoutChanges="true" />
        </ScrollView>

        <EditText
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="24sp"
            android:gravity="end"
            android:background="@null"
            android:inputType="textNoSuggestions"
            android:textIsSelectable="true"
            android:minLines="1"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="48sp"
            android:gravity="end"
            android:textStyle="bold"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="24sp"
            android:autoSizeMaxTextSize="48sp" />
    </LinearLayout>

    <!-- Inline Math Input Display (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutMathDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_button_num"
        android:layout_marginBottom="12dp"
        android:padding="16dp"
        android:elevation="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMathPrefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GCD("
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMathBox1"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:gravity="center"
            android:padding="4dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" , "
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMathBox2"
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:background="#222222"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:gravity="center"
            android:padding="4dp"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=")"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>



    <!-- Top Grid: Scientific Functions (4 rows, 5 cols) -->
    <GridLayout
        android:id="@+id/gridScientific"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="4"
        android:layout_gravity="center">

        <Button android:id="@+id/btnBin" android:text="BIN" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnPrime" android:text="PRIME" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnGcd" android:text="GCD" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnLcm" android:text="LCM" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnDeg" android:text="DEG" style="@style/CalcBtnSci" />

        <Button android:id="@+id/btnSin" android:text="sin" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnCos" android:text="cos" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnTan" android:text="tan" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnLn" android:text="ln" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnLog" android:text="log" style="@style/CalcBtnSci" />

        <Button android:id="@+id/btnPi" android:text="π" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnE" android:text="e" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnSqrt" android:text="√" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnPower" android:text="^" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnSquare" android:text="x²" style="@style/CalcBtnSci" />

        <Button android:id="@+id/btnFact" android:text="n!" style="@style/CalcBtnSci" />
        <Button android:id="@+id/btnOpenP" android:text="(" style="@style/CalcBtnFunc" />
        <Button android:id="@+id/btnCloseP" android:text=")" style="@style/CalcBtnFunc" />
        <Button android:id="@+id/btnMod" android:text="mod" style="@style/CalcBtnSci" android:layout_columnSpan="2" android:layout_gravity="fill" />
    </GridLayout>

    <!-- Lower Controls Container -->
    <LinearLayout
        android:id="@+id/layoutLowerControls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:orientation="vertical">

        <!-- Middle Bar: Operators -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.2"
            android:orientation="horizontal">

            <Button android:id="@+id/btnPlus" android:text="+" style="@style/CalcBtnOp" android:layout_height="match_parent" android:layout_weight="1"/>
            <Button android:id="@+id/btnMinus" android:text="−" style="@style/CalcBtnOp" android:layout_height="match_parent" android:layout_weight="1"/>
            <Button android:id="@+id/btnMultiply" android:text="×" style="@style/CalcBtnOp" android:layout_height="match_parent" android:layout_weight="1"/>
            <Button android:id="@+id/btnDivide" android:text="÷" style="@style/CalcBtnOp" android:layout_height="match_parent" android:layout_weight="1"/>
        </LinearLayout>

        <!-- Bottom Grid: Numpad (4 rows, 4 cols) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:columnCount="4"
            android:rowCount="4"
            android:layout_gravity="center">

            <Button android:id="@+id/btn7" android:text="7" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btn8" android:text="8" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btn9" android:text="9" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btnClear" android:text="AC" style="@style/CalcBtnClear" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />

            <Button android:id="@+id/btn4" android:text="4" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btn5" android:text="5" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btn6" android:text="6" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btnBackspace" android:text="⌫" style="@style/CalcBtnClear" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />

            <Button android:id="@+id/btn1" android:text="1" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btn2" android:text="2" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btn3" android:text="3" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Button android:id="@+id/btnEquals" android:text="=" style="@style/CalcBtnEquals" android:layout_height="0dp" android:layout_rowWeight="2" android:layout_rowSpan="2" android:layout_gravity="fill" />

            <Button android:id="@+id/btn0" android:text="0" style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_columnSpan="2" android:layout_gravity="fill" />
            <Button android:id="@+id/btnDot" android:text="." style="@style/CalcBtnNum" android:layout_height="0dp" android:layout_rowWeight="1" android:layout_gravity="fill" />
            <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" />
        </GridLayout>
    </LinearLayout>
</LinearLayout>
